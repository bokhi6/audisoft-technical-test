{
  "info": {
    "name": "AudiSoft API",
    "description": "Coleccion de endpoints REST para la gestion de Estudiantes, Profesores y Notas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5080/api", "type": "string" }
  ],
  "item": [
    {
      "name": "Estudiantes",
      "item": [
        {
          "name": "Listar (paginado)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/estudiantes?pageNumber=1&pageSize=3",
              "host": ["{{baseUrl}}"],
              "path": ["estudiantes"],
              "query": [
                { "key": "pageNumber", "value": "1" },
                { "key": "pageSize", "value": "3" }
              ]
            }
          }
        },
        {
          "name": "Listar simple (para selects)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/estudiantes/lista", "host": ["{{baseUrl}}"], "path": ["estudiantes", "lista"] }
          }
        },
        {
          "name": "Obtener por id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/estudiantes/1", "host": ["{{baseUrl}}"], "path": ["estudiantes", "1"] }
          }
        },
        {
          "name": "Crear",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Nuevo Estudiante\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/estudiantes", "host": ["{{baseUrl}}"], "path": ["estudiantes"] }
          }
        },
        {
          "name": "Actualizar",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Nombre Actualizado\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/estudiantes/1", "host": ["{{baseUrl}}"], "path": ["estudiantes", "1"] }
          }
        },
        {
          "name": "Eliminar (409 si tiene notas asociadas)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/estudiantes/1", "host": ["{{baseUrl}}"], "path": ["estudiantes", "1"] }
          }
        }
      ]
    },
    {
      "name": "Profesores",
      "item": [
        {
          "name": "Listar (paginado)",
          "request": {
            "method": "GET",
            "url": {
