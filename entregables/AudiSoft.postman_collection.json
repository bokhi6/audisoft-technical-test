          }
        },
        {
          "name": "Listar simple (para selects)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/profesores/lista", "host": ["{{baseUrl}}"], "path": ["profesores", "lista"] }
          }
